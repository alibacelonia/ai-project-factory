from __future__ import annotations

{% if authentication %}
import os

{% endif %}
from fastapi import [[ "FastAPI, Header, HTTPException, status" if authentication else "FastAPI" ]]
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from app.config import Settings

settings = Settings.from_environment()
app = FastAPI(title="[[ project_name ]] API", version="0.1.0")
app.add_middleware(
    CORSMiddleware,
    allow_origins=list(settings.cors_origins),
    allow_credentials=False,
    allow_methods=["GET"],
    allow_headers=["Authorization", "Content-Type"],
)

{% if authentication or database_migrations or ai_integration or background_jobs or subscriptions or email_notifications %}
ENABLED_FEATURES = [
{% if authentication %}    "authentication",
{% endif %}{% if database_migrations %}    "database_migrations",
{% endif %}{% if ai_integration %}    "ai_integration",
{% endif %}{% if background_jobs %}    "background_jobs",
{% endif %}{% if subscriptions %}    "subscriptions",
{% endif %}{% if email_notifications %}    "email_notifications",
{% endif %}]
{% else %}
ENABLED_FEATURES: list[str] = []
{% endif %}


class HealthResponse(BaseModel):
    status: str
    service: str
    enabled_features: list[str]


@app.get("/health", response_model=HealthResponse)
def health() -> HealthResponse:
    """Liveness check; deliberately independent from PostgreSQL."""

    return HealthResponse(
        status="ok", service="[[ project_slug ]]-backend", enabled_features=ENABLED_FEATURES
    )
{% if authentication %}


class UserResponse(BaseModel):
    subject: str


@app.get("/api/me", response_model=UserResponse)
def current_user(authorization: str | None = Header(default=None)) -> UserResponse:
    """Development auth seam; replace it with the provider selected in requirements."""

    expected = os.getenv("AUTH_DEVELOPMENT_TOKEN")
    if not expected:
        raise HTTPException(status.HTTP_503_SERVICE_UNAVAILABLE, "Authentication is not configured")
    if authorization != f"Bearer {expected}":
        raise HTTPException(status.HTTP_401_UNAUTHORIZED, "Invalid bearer token")
    return UserResponse(subject="development-user")
{% endif %}
