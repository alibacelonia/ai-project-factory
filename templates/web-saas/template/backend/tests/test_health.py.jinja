from fastapi.testclient import TestClient

from app.main import app

client = TestClient(app)


def test_health_does_not_require_database() -> None:
    response = client.get("/health")

    assert response.status_code == 200
    assert response.json()["status"] == "ok"
    assert response.json()["service"] == "[[ project_slug ]]-backend"
{% if authentication %}


def test_authentication_is_closed_when_unconfigured(monkeypatch) -> None:
    monkeypatch.delenv("AUTH_DEVELOPMENT_TOKEN", raising=False)

    response = client.get("/api/me")

    assert response.status_code == 503
{% endif %}
