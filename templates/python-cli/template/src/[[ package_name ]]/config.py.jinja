from __future__ import annotations

import os
from dataclasses import dataclass


@dataclass(frozen=True)
class Settings:
    log_level: str = "INFO"
    greeting_prefix: str = "Hello"

    @classmethod
    def from_environment(cls) -> Settings:
        level = os.getenv("[[ package_name | upper ]]_LOG_LEVEL", "INFO").upper()
        if level not in {"DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"}:
            level = "INFO"
        return cls(
            log_level=level,
            greeting_prefix=os.getenv("[[ package_name | upper ]]_GREETING_PREFIX", "Hello"),
        )
