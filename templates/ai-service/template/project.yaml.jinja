project:
  name: [[ project_name ]]
  description: [[ description | tojson ]]
  type: ai-service
  stage: mvp
  template_version: "[[ template_version ]]"

stack:
  language: python
  backend: fastapi
  frontend: null
  database: null

features:
  ai_integration: [[ ai_integration | lower ]]
  background_jobs: [[ background_jobs | lower ]]
  llm_provider: [[ llm_provider | lower ]]
  aws_bedrock: [[ aws_bedrock | lower ]]
  openai_api: [[ openai_api | lower ]]
  rag: [[ rag | lower ]]
  vector_database: [[ vector_database | lower ]]
  document_processing: [[ document_processing | lower ]]

deployment:
  provider: local
  docker: false

development:
  testing: true
  linting: true
  ci_cd: true

constraints:
  prioritize_low_cost: true
  offline_development: true

